# ── ShopVerse environment variables ────────────────────────────
# Copy this file to .env and fill in your values.

# MongoDB connection string.
#  Local dev : mongodb://127.0.0.1:27017/shopverse
#  Atlas     : mongodb+srv://<user>:<password>@<cluster>.mongodb.net/shopverse?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/shopverse

# Secret used to sign JWT session cookies.
# Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
